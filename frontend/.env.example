# 复制为 .env.local 后按需填写（.env.local / *.local 已被 .gitignore 排除）

# 后端 conf/app_config.yaml 里 api.api_key 填了值时必须保持一致，否则查询接口返回 401
VITE_API_KEY=

# 可选：指向其它后端（默认走 /api/query，由 Vite 代理转发到 127.0.0.1:8000）
# VITE_QUERY_ENDPOINT=/api/query

# 可选：连接与静默超时（毫秒），一般不用改
# VITE_QUERY_CONNECT_TIMEOUT_MS=30000
# VITE_QUERY_IDLE_TIMEOUT_MS=180000
