# 复制为 .env 后填写自己的密码：cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到仓库。
#
# 注意：这里的账号密码要与 conf/app_config.yaml（或 app_config.local.yaml）保持一致。

# MySQL root 密码
MYSQL_ROOT_PASSWORD=change-me

# 应用主账号：元数据库 meta 需要写权限（元知识构建脚本要写表 / 字段 / 指标）
MYSQL_USER=mingshu
MYSQL_PASSWORD=change-me

# 数仓只读账号：应用执行 LLM 生成的 SQL 用它，数据库层面就写不进去（见 README「SQL 安全」）
DA_READONLY_USER=da_readonly
DA_READONLY_PASSWORD=change-me
